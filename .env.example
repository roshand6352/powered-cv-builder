APP_NAME="ApplyDocs ZA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Set APP_DEBUG=false in production for much faster responses.
APP_URL=http://ai-powered-cv-builder-fresh.test
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Use LOG_LEVEL=warning or error in production.

# MySQL (Laragon defaults)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_powered_cv_builder_fresh
DB_USERNAME=root
DB_PASSWORD=

# file is faster than database for local dev; database is fine for multi-server setups.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file or redis is faster than database for cache reads.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum (SPA / API token auth)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,ai-powered-cv-builder-fresh.test

# Google OAuth (Login / Register with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Filament admin panel
FILAMENT_FILESYSTEM_DISK=public

# Spatie Media Library
MEDIA_DISK=public

# PDF engine: browsershot | dompdf (switch engines by changing this value only)
PDF_HOSTS=browsershot

# DomPDF — used when PDF_HOSTS=dompdf
DOMPDF_DEFAULT_FONT="DejaVu Sans"
DOMPDF_DPI=96

# Browsershot (PDF / screenshot generation via Puppeteer)
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_PDF_FORMAT=A4
BROWSERSHOT_SCREENSHOT_WIDTH=1200
BROWSERSHOT_SCREENSHOT_HEIGHT=800
BROWSERSHOT_TIMEOUT=120

# AI (OpenAI)
AI_PROVIDER=groq

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1500
GROQ_TEMPERATURE=0.7
GROQ_TIMEOUT=60

AI_DEFAULT_CREDITS_LIMIT=10
AI_QUEUE=default

# PayFast
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_CURRENCY=ZAR

VITE_APP_NAME="${APP_NAME}"
